{
	"format_version": "1",
	"blocks": {
		//隐藏结构方块边框
		"minecraft:structure_block": {
			"name": "structure_block"
		},
		//圆石压力板-传送圆环
		"minecraft:stone_pressure_plate": {
			"name": "plbe_cd_plate",
			"geometry": "geometry.plbe_cd_plate",
			"state_overrides": {
				"powered=true": {
					"material_instances": {
						"*": {
							"texture": "plbe_cd_plate_actived",
							"render_method": "alpha_test",
							"face_dimming": true,
							"ambient_occlusion": true
						}
					}
				},
				"powered=false": {
					"material_instances": {
						"*": {
							"texture": "plbe_cd_plate",
							"render_method": "alpha_test",
							"face_dimming": true,
							"ambient_occlusion": true
						}
					}
				}
			}
		},
		//轻型测重压力板-NPC感应板
		"minecraft:light_weighted_pressure_plate": {
			"name": "plbe_light_pressure_plate",
			"geometry": "geometry.plbe_light_pressure_plate",
			"material_instances": {
				"*": {
					"texture": "plbe_light_pressure_plate",
					"face_dimming": true,
					"ambient_occlusion": true
				}
			}
		},
		//棕色地毯-木地板
		"minecraft:brown_carpet": {
			"name": "plbe_brown_carpet",
			"geometry": "geometry.plbe_brown_carpet",
			"material_instances": {
				"*": {
					"texture": "plbe_sponge_top",
					"face_dimming": true,
					"ambient_occlusion": true
				}
			}
		},
		//漏斗-投放桶
		"minecraft:hopper": {
			"name": "plbe_hopper",
			"geometry": "geometry.plbe_hopper_down",
			"state_overrides": {
				"enabled=true,facing=north": {
					"geometry": "geometry.plbe_hopper_side"
				},
				"enabled=true,facing=south": {
					"geometry": "geometry.plbe_hopper_side",
					"transformation": { "rotation": [ 0, 180, 0 ] }
				},
				"enabled=true,facing=west": {
					"geometry": "geometry.plbe_hopper_side",
					"transformation": { "rotation": [ 0, 90, 0 ] }
				},
				"enabled=true,facing=east": {
					"geometry": "geometry.plbe_hopper_side",
					"transformation": { "rotation": [ 0, 270, 0 ] }
				},
				"enabled=false,facing=north": {
					"geometry": "geometry.plbe_hopper_side"
				},
				"enabled=false,facing=south": {
					"geometry": "geometry.plbe_hopper_side",
					"transformation": { "rotation": [ 0, 180, 0 ] }
				},
				"enabled=false,facing=west": {
					"geometry": "geometry.plbe_hopper_side",
					"transformation": { "rotation": [ 0, 90, 0 ] }
				},
				"enabled=false,facing=east": {
					"geometry": "geometry.plbe_hopper_side",
					"transformation": { "rotation": [ 0, 270, 0 ] }
				}
			},
			"material_instances": {
				"*": {
					"texture": "plbe_textures_mix_1",
					"face_dimming": true,
					"ambient_occlusion": true
				}
			}
		},
		//绿色玻璃-棋盘
		"minecraft:green_stained_glass": {
			"name": "plbe_glass_green",
			"geometry": "geometry.plbe_glass_green",
			"material_instances": {
				"*": {
					"texture": "plbe_glass_green",
					"face_dimming": true,
					"ambient_occlusion": true
				}
			}
		},
		//橙色玻璃-茶具
		"minecraft:orange_stained_glass": {
			"name": "plbe_glass_orange",
			"geometry": "geometry.plbe_glass_orange",
			"material_instances": {
				"*": {
					"texture": "plbe_glass_orange",
					"face_dimming": true,
					"ambient_occlusion": true
				}
			}
		},
		//淡灰色玻璃-书台
		"minecraft:light_gray_stained_glass": {
			"name": "plbe_glass_gray",
			"geometry": "geometry.plbe_glass_gray",
			"material_instances": {
				"*": {
					"texture": "plbe_glass_gray",
					"face_dimming": true,
					"ambient_occlusion": true
				}
			}
		},
		//湿海绵-木桶
		"minecraft:wet_sponge": {
			"name": "plbe_wet_sponge",
			"geometry": "geometry.plbe_wet_sponge",
			"material_instances": {
				"*": {
					"texture": "plbe_textures_mix_1",
					"face_dimming": true,
					"ambient_occlusion": true
				}
			}
		},
		//暗海晶石-毒液桶
		"minecraft:dark_prismarine": {
			"name": "plbe_dark_prismarine_1",
			"geometry": "geometry.plbe_dark_prismarine_1",
			"material_instances": {
				"*": {
					"texture": "plbe_textures_mix_1",
					"face_dimming": true,
					"ambient_occlusion": true
				}
			}
		},
		//深色橡木原木-茶桶
		"minecraft:dark_oak_log": {
			"name": "plbe_dark_oak_log",
			"state_overrides": {
				"axis=z": {
					"geometry": "geometry.plbe_dark_oak_log_side"
				},
				"axis=x": {
					"geometry": "geometry.plbe_dark_oak_log_side",
					"transformation":{ "rotation":[0,90,0] }
				}
			},
			"material_instances": {
				"*": {
					"texture": "plbe_textures_mix_1",
					"render_method": "alpha_test",
					"face_dimming": true,
					"ambient_occlusion": true
				}
			}
		},
		//相思树原木-杂货篓
		"minecraft:acacia_log": {
			"name": "plbe_acacia_log_y",
			"geometry": "geometry.plbe_acacia_log",
			"state_overrides": {
				"axis=z": {
					"material_instances": {
						"*": {
							"texture": "plbe_acacia_log_z",
							"render_method": "alpha_test",
							"face_dimming": true,
							"ambient_occlusion": true
						}
					}
				},
				"axis=x": {
					"material_instances": {
						"*": {
							"texture": "plbe_acacia_log_x",
							"render_method": "alpha_test",
							"face_dimming": true,
							"ambient_occlusion": true
						}
					}
				}
			}
		}
	}
